# Dockerfile para Frontend (use este para o serviço web no Easypanel)
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar package.json
COPY package*.json ./

# Instalar dependências
RUN npm ci

# Copiar código fonte
COPY . .

# Verificar se o arquivo clients.ts existe
RUN ls -la src/services/clients.ts || (echo "ERRO: clients.ts não encontrado!" && ls -la src/services/ && exit 1)

# Build da aplicação
RUN npm run build

# Verificar se o dist foi criado (no stage builder)
RUN ls -la dist/ || (echo "ERRO: dist não foi criado!" && ls -la && exit 1)
RUN ls -la dist/index.html || (echo "ERRO: index.html não encontrado no dist!" && exit 1)

# Production stage
FROM nginx:alpine

# Copiar arquivos buildados
COPY --from=builder /app/dist /usr/share/nginx/html

# Verificar se os arquivos foram copiados (no stage de produção)
RUN ls -la /usr/share/nginx/html/ || (echo "ERRO: arquivos não foram copiados!" && exit 1)
RUN ls -la /usr/share/nginx/html/index.html || (echo "ERRO: index.html não encontrado!" && exit 1)

# Copiar configuração do nginx
# Use nginx.conf.prod se estiver fazendo proxy interno, ou nginx.conf se usar domínio externo
COPY nginx.conf.prod /etc/nginx/conf.d/default.conf

# Nota: Não validamos nginx -t aqui porque o host "painelcrm" só existe em runtime
# A validação será feita quando o container iniciar

# Expor porta
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Iniciar nginx
CMD ["nginx", "-g", "daemon off;"]
