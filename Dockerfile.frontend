# Dockerfile para Frontend (use este para o serviço web no Easypanel)
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar package.json
COPY package*.json ./

# Instalar dependências
RUN npm ci

# Copiar código fonte
COPY . .

# Verificar se o arquivo clients.ts existe
RUN ls -la src/services/clients.ts || (echo "ERRO: clients.ts não encontrado!" && ls -la src/services/ && exit 1)

# Build da aplicação
RUN npm run build

# Production stage
FROM nginx:alpine

# Copiar arquivos buildados
COPY --from=builder /app/dist /usr/share/nginx/html

# Copiar configuração do nginx
# Use nginx.conf.prod se estiver fazendo proxy interno, ou nginx.conf se usar domínio externo
COPY nginx.conf.prod /etc/nginx/conf.d/default.conf

# Expor porta
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Iniciar nginx
CMD ["nginx", "-g", "daemon off;"]
