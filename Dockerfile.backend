# ---- Build stage ----
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files and install ALL dependencies (including devDependencies for tsc)
COPY packages/backend/package*.json ./
RUN npm ci

# Copy source and build TypeScript
COPY packages/backend/ ./
RUN npm run build

# ---- Production stage ----
FROM node:20-alpine

WORKDIR /app

# Install production dependencies only
COPY packages/backend/package*.json ./
RUN npm ci --omit=dev

# Copy compiled output from builder
COPY --from=builder /app/dist ./dist

# Copy migrations (SQL files) so "npm run migrate" works in container
COPY database ./database

# Script para criar super admin (executar no container: node scripts/create-superadmin.mjs <email> <senha>)
COPY packages/backend/scripts ./scripts

EXPOSE 3001

CMD ["node", "dist/index.js"]
