          "type": "open_question",
          "position": { "x": 400, "y": 0 },
          "data": {
            "prompt": "Digite seu nome",
            "variable": "nome",
            "save_to_contact": true,
            "contact_field": "name"
          }
        },
        {
          "id": "menu1",
          "type": "options",
          "position": { "x": 600, "y": 0 },
          "data": {
            "text": "Escolha:",
