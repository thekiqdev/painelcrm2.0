              "Content-Type": "application/json",
              "x-api-key": "SECRET_SHOULD_NOT_LEAK",
              "Authorization": "Bearer SECRET_TOKEN"
            },
            "body": "{\"name\":\"{{nome}}\"}",
            "save_mappings": [{ "path": "json.name", "variable": "echo_name" }]
