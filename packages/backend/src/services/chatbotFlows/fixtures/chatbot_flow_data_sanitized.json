{
  "export_version": 1,
  "name": "Fluxo Safe (fixture S21)",
  "chatbot": {
    "name": "Fluxo Safe (fixture S21)",
    "flow_data": {
      "nodes": [
        {
          "id": "start1",
          "type": "start",
          "position": { "x": 0, "y": 0 },
          "data": { "trigger": { "type": "first_message" } }
        },
        {
          "id": "msg1",
          "type": "message",
          "position": { "x": 200, "y": 0 },
          "data": { "text": "Olá! Qual seu nome?" }
