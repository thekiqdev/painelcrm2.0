        },
        {
          "id": "wait1",
          "type": "wait",
          "position": { "x": 1200, "y": 0 },
          "data": { "seconds": 30 }
        },
        {
          "id": "tag1",
          "type": "contact_label_add",
          "position": { "x": 1400, "y": 0 },
          "data": { "tag_label": "bot-import", "tag_id": "ext-99" }
        },
        {
          "id": "human1",
          "type": "transfer_to_human",
          "position": { "x": 1600, "y": 0 },
