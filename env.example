# Configuração do Banco de Dados PostgreSQL
# Use outra porta (ex.: 5433, 5434) se já tiver outro PostgreSQL na 5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=painelcrm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Configuração da API
API_PORT=3001
NODE_ENV=development

# Configuração JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Configuração do Frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Integração WhatsApp (UazAPI)
UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_ADMIN_TOKEN=ZaW1qwTEkuq7Ub1cBUuyMiK5bNSu3nnMQ9lh7klElc2clSRV8t
UAZAPI_WEBHOOK_SECRET=my-webhook-secret
UAZAPI_WEBHOOK_URL=http://localhost:3001/webhooks/uazapi
