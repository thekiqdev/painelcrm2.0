# Configuração do Banco de Dados PostgreSQL
# Use outra porta (ex.: 5433, 5434) se já tiver outro PostgreSQL na 5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=painelcrm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Configuração da API
API_PORT=3001
NODE_ENV=development
# Limite do body JSON no Express (ex.: imagem base64 no chat). Padrão no código: 25mb.
# Só tem efeito DEPOIS que o pedido passa pelo proxy. Se o browser mostrar 413 com "<center>nginx</center>",
# o bloqueio é no nginx (ou painel Easypanel / Traefik), NÃO se corrige só com esta variável.
# API_JSON_BODY_LIMIT=25mb
#
# --- 413 "Request Entity Too Large" (nginx na VPS) ---
# No servidor, no bloco server { } ou em location ^~ /api/ { }, defina por exemplo:
#   client_max_body_size 50m;
# (o default do nginx costuma ser 1m). Reinicie o nginx. Se usar Docker, aplique no ficheiro montado
# no contentor do proxy; o nginx.conf deste repositório já usa 50m como referência.

# Configuração JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Opcional: cifra do token de link público de visualização de contrato (recomendado em produção; 32+ caracteres).
# Se omitido, a chave é derivada de JWT_SECRET (menos ideal se o segredo JWT mudar).
# CONTRACT_PUBLIC_VIEW_TOKEN_ENCRYPTION_KEY=

# Configuração do Frontend (CORS + links do backend, ex.: "Acessar como" no Super Admin).
# Em produção na VPS, defina a URL pública do app (ex.: https://crm.suaempresa.com).
# Se omitir, o impersonate tenta usar o header Origin/Referer do navegador; em dev o fallback é http://localhost:8080.
FRONTEND_URL=http://localhost:5173
# Opcional: várias origens CORS separadas por vírgula; a primeira também pode ser usada como base do impersonate.
# FRONTEND_URLS=https://app.exemplo.com,https://www.exemplo.com

# Nome público da plataforma (merge fields {{system.name}} no PDF/contrato). Opcional.
# APP_PUBLIC_NAME=PainelCRM

# Fase 1 — checkout único (opcional; bloqueio de cadastro legado)
DISABLE_PUBLIC_AUTH_REGISTER=false
DISABLE_PUBLIC_REGISTER_ORGANIZATION=false

# Frontend — Fase 1 (build-time)
# Opcional: nome exibido em previews de merge ({{system.name}}). Senão usa "PainelCRM".
# VITE_APP_PUBLIC_NAME=PainelCRM
# Redireciona /register para /checkout quando true
VITE_REDIRECT_REGISTER_TO_CHECKOUT=true
# Só redireciona para /onboarding quando true (legado)
VITE_FORCE_LEGACY_ONBOARDING_ROUTE=false
# Dev: porta do Vite para `npm run dev:landing` (landing leve). Padrão no vite.landing.config: 8082.
# VITE_LANDING_DEV_PORT=8082

# Fase 2 — trial no checkout (backend: ligar explicitamente em cada ambiente)
# Se os três estiverem false, o gate de CRM trial/retomada e o ramo Fase 2 em cancelExpired ficam desligados.
CHECKOUT_TRIAL_V1=true
TRIAL_EXPIRATION_JOB=true
CHECKOUT_RESUME_V1=true

# Frontend — Fase 2
# CTA de trial: padrão ligado; defina VITE_CHECKOUT_TRIAL_V1=false para ocultar o botão de trial.
VITE_CHECKOUT_TRIAL_V1=true
VITE_CHECKOUT_RESUME_V1=true

# Opcional: segredo dedicado à assinatura de URLs públicas de mídia (GET /api/public/catalog-media/raw).
# Se omitido, usa JWT_SECRET. As APIs /auth/me e perfil re-emitem URLs com assinatura atual ao ler o avatar.
# Durante rotação de segredo, defina também o anterior para GET raw aceitar links antigos na BD:
# CATALOG_MEDIA_PUBLIC_TOKEN_SECRET_PREVIOUS=
# CATALOG_MEDIA_PUBLIC_TOKEN_SECRET=

# Catálogo / Loja — Fase 2 (upload local no servidor, multipart)
# Caminho físico da raiz de uploads. Dentro dele o backend usa a subpasta "catalog-media".
# EasyPanel: monte um volume PERSISTENTE neste caminho (ex.: /app/data/uploads).
# Se omitido, usa {diretório de trabalho do Node}/uploads/catalog-media (NÃO persiste entre redeploy sem volume).
# CATALOG_MEDIA_STORAGE_PATH=/app/data/uploads
#
# URL pública usada nas URLs gravadas no banco (logo, banner, images). Sem barra final.
# Use a mesma origem que o navegador usa para a API se o proxy repassar /media/catalog (recomendado).
# Ex.: https://app.seudominio.com ou  http://localhost:3001 (dev com front em outra porta)
# Se omitido, o backend monta a URL a partir do Host da requisição de upload (requer proxy/trust proxy corretos).
# CATALOG_MEDIA_PUBLIC_BASE_URL=https://app.seudominio.com
#
# URLs públicas de catálogo/logos: GET /api/public/catalog-media/raw?k=&s= (path sem .png; mesmo proxy que /api/public/...).
# Nginx: use location ^~ /api/ com proxy_pass ao Node (ver nginx.conf). Evita location regex *.png a servir /api/... como ficheiro estático.
# Se ainda aparecer 413 no nginx, aumente client_max_body_size (ex.: 50m) acima do tamanho real do JSON enviado.
#
# Limite por arquivo (bytes). Padrão no código: 5 MB.
# CATALOG_MEDIA_UPLOAD_MAX_BYTES=5242880
# Desliga upload no backend (503): CATALOG_MEDIA_UPLOAD_ENABLED=false
# CATALOG_MEDIA_UPLOAD_ENABLED=true
# Frontend: defina false para ocultar botões de upload (opcional).
# VITE_CATALOG_MEDIA_UPLOAD_ENABLED=true

# MediaService (GET /api/media/v1/raw) — avatares WhatsApp cacheados, assets internos.
# Raiz física no container; DEVE ser volume persistente em produção (ex.: /storage/media).
# Se omitido: {cwd}/storage/media — redeploy sem volume apaga ficheiros.
# MEDIA_STORAGE_ROOT=/storage/media
# Assinatura HMAC das URLs: preferir MEDIA_SIGNING_SECRET fixo; senão CATALOG_MEDIA_PUBLIC_TOKEN_SECRET; senão JWT_SECRET.
# MEDIA_SIGNING_SECRET=
# MEDIA_AVATAR_WHATSAPP_ENABLED=true
# MEDIA_ASSETS_WRITE_ENABLED=true
# Logs sanitizados por pedido em GET /api/media/v1/raw (desligar após diagnóstico).
# MEDIA_RAW_DIAGNOSTIC_LOGS=false

# Loja — checkout público (1 item): liberado só pela loja em Admin → Loja (store_checkout_enabled + loja ativa).
# Não usa rotas /checkout (plano SaaS) nem /api/me/tenant/checkout-context.
# Limite dedicado do POST /api/store-checkout (requisições / 15 min por IP). Não contabiliza no RATE_LIMIT_MAX geral.
# RATE_LIMIT_STORE_CHECKOUT_MAX=40

# Etapa 3 — link público de visualização de contrato (GET /api/public/contracts/view/:token), requisições / 15 min por IP+token.
# RATE_LIMIT_PUBLIC_CONTRACT_VIEW_MAX=120

# Propostas — link público (GET /api/public/proposals/view/:token e POST accept|reject), / 15 min por IP+token.
# RATE_LIMIT_PUBLIC_PROPOSAL_VIEW_MAX=120
# RATE_LIMIT_PUBLIC_PROPOSAL_ACTION_MAX=40
# Tamanho do secret aleatório em bytes (default 32). Opcional.
# CONTRACT_PUBLIC_VIEW_TOKEN_BYTES=32
# Expiração opcional do token em dias (omitir = sem expiração automática).
# CONTRACT_PUBLIC_VIEW_TOKEN_EXPIRY_DAYS=

# Etapa 4 — convite público de assinatura por signatário
# RATE_LIMIT_PUBLIC_CONTRACT_SIGNATURE_GET_MAX=120
# RATE_LIMIT_PUBLIC_CONTRACT_SIGNATURE_POST_MAX=30
# CONTRACT_SIGNATURE_INVITE_EXPIRY_DAYS=

# Integração WhatsApp (UazAPI)
# UAZAPI_ADMIN_TOKEN: token administrativo do painel UazAPI (obrigatório no backend para POST /instance/init).
# Não é o JWT do usuário do PainelCRM — configure só no servidor / secrets.
UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_ADMIN_TOKEN=ZaW1qwTEkuq7Ub1cBUuyMiK5bNSu3nnMQ9lh7klElc2clSRV8t
UAZAPI_WEBHOOK_URL=http://localhost:3001/webhooks/uazapi
# Predefinição: callback registado como …/webhooks/uazapi/v2/:chatInstanceId/:webhookToken (token = chat_instances.webhook_secret).
# A UazAPI pode POSTar para esse URL com sufixos (ex.: …/v2/…/…/messages/text); o backend aceita.
# Só use legacy ?instanceId=&secret= em migração pontual:
# UAZAPI_WEBHOOK_LEGACY_QUERY_URL=true
# Produção: use URL pública HTTPS (ou defina só PUBLIC_API_URL abaixo — o backend monta .../webhooks/uazapi).
# PUBLIC_API_URL=https://beta.painelcrm.com
UAZAPI_WEBHOOK_SECRET=my-webhook-secret
# O webhook também aceita o token da instância em ?secret= (comportamento comum da Uaz): deve coincidir com chat_instances.instance_token.
# Deve ser idêntico ao parâmetro ?secret= da URL na Uaz. Em produção confira as variáveis do deploy (Docker/PM2/host):
# aspas no valor, espaço final ou secret antigo causam invalid_secret mesmo com hasQuerySecret=true.
# O mesmo valor deve estar configurado no painel UazAPI (secret do webhook). O backend envia o secret no body
# da API Uaz e também em ?secret= na URL registrada, para o POST do webhook validar mesmo sem header.
# Após POST /webhook, o backend chama GET /webhook: se a URL registada tiver ?secret= diferente do valor local,
# atualiza chat_instances.webhook_secret e reenvia o POST (logs webhook_secret_reconciled_from_provider / webhook_configure_audit).
# metadata.webhook.uazDeliverySecrets inclui secrets extraídos da resposta para entregas que não coincidem com a coluna.
# Opcional: IPs fixos do provedor (vistos nos logs do webhook). Ex.: 116.202.152.37 — só use se confiar no proxy (trust proxy).
# UAZAPI_WEBHOOK_TRUST_IPS=116.202.152.37
# Produção: webhook exige secret definido. Só use durante migração:
# UAZAPI_WEBHOOK_ALLOW_NO_SECRET=true
# Logs detalhados da integração (payloads, handshake WS, etc.):
# UAZAPI_VERBOSE_LOGS=1
# Depuração pontual do webhook (candidatos de instância no payload, fingerprints de secret). Produção: só tempo limitado.
# UAZAPI_WEBHOOK_PAYLOAD_DEBUG=1
# Logs por mensagem em saveMessage (sync/webhook). Só ative para depuração pontual:
# CHAT_VERBOSE_SAVE=1
#
# Worker de mensagens de chat agendadas (envio por hora; intervalo de varredura em ms). Default 30000; mínimo 15000.
# CHAT_SCHEDULED_MESSAGES_POLL_MS=30000
#
# Herança legacy de conversas ao reconectar com o mesmo phone_key: por defeito DESLIGADA (reconexão limpa).
# Só ative se precisar do comportamento antigo (mover conversas entre instâncias do mesmo número):
# WHATSAPP_INHERIT_CONVERSATIONS_ON_CONNECT=true

# Asaas — timeout HTTP por requisição (ms). Padrão no código: 40000; valores 5000–120000 são aplicados com piso 20000. Sandbox lento: aumente se necessário.
# ASAAS_HTTP_TIMEOUT_MS=45000

# --- Billing / faturas recorrentes (CRM + SaaS) — processos SEPARADOS da API HTTP ---
# A API principal (npm run dev / start) NÃO enfileira nem processa jobs de recorrência.
# Em produção (Docker, PM2, EasyPanel): defina DOIS comandos/crons adicionais com o MESMO .env e POSTGRES_* que o backend:
#   1) Scheduler (ex. a cada 10–15 min): cd packages/backend && npm run billing:scheduler
#   2) Worker (ex. a cada 1–2 min):       cd packages/backend && npm run billing:worker
# Heartbeat (migração 248): cada execução grava em billing_ops_heartbeat; ver GET /api/superadmin/billing/recurring-jobs → process_heartbeats
#
# Docker / EasyPanel (produção): serviços separados — ver Dockerfile.billing-worker, Dockerfile.billing-scheduler, docs/EASYPANEL-BILLING-WORKER-SCHEDULER.md
# BILLING_WORKER_LOOP_SECONDS=15
# BILLING_SCHEDULER_LOOP_SECONDS=600
# Opcional: identificador da instância do worker nos logs/lock (várias réplicas):
# RECURRING_WORKER_ID=worker-1
# Faturas filhas por item (E2): desligar explicitamente com false (default no código: ligado).
# BILLING_CHILD_ITEM_INVOICES_ENABLED=true
# BILLING_CHILD_BATCH_LIMIT=50
# Logs detalhados do scheduler (uma linha por assinatura enfileirada / skip). Default: false.
# BILLING_SCHEDULER_VERBOSE=false
# Fase 0 (observabilidade): logs detalhados de timezone/janela local por tenant no scheduler/worker (sem alterar comportamento real).
# BILLING_TIME_WINDOW_VERBOSE=false
# Log extra com notify:true quando o worker completa ciclo CRM sem nova fatura (Etapa 2). Default: false.
# BILLING_ALERT_ON_NO_INVOICE_CYCLE=false

# Depuração pontual — listagem de conversas do chat (logs backend + ?diag=1 via frontend em DEV)
# CHAT_LIST_LOG=1
# VITE_CHAT_LIST_DIAG=1

# Motor Central de Notificações (Fase 2+)
# Liga rotas /api/notifications-engine e processamento do núcleo.
# NOTIFICATIONS_ENGINE_ENABLED=true
# Fase 3: publicação automática a partir de propostas/contratos/faturas (requer NOTIFICATIONS_ENGINE_ENABLED).
# NOTIFICATIONS_ENGINE_BUSINESS_EVENTS_ENABLED=false
# Fase 4: piloto — se definido (CSV de UUID de tenants), só estes recebem eventos de negócio (vazio = todos).
# NOTIFICATIONS_ENGINE_BUSINESS_EVENTS_TENANT_IDS=
# Opcional: lista separada por vírgulas de event_key permitidos (vazio = todos).
# Cuidado: se listar só faturas, propostas e contratos deixam de publicar (ver docs/notifications-engine/PROPOSAL_EVENTS_DEBUG.md).
# NOTIFICATIONS_ENGINE_BUSINESS_EVENTS_KEYS=proposal.sent,proposal.accepted,invoice.paid
# Envio real WhatsApp (UazAPI). Se false, entregas ficam status skipped após render.
# NOTIFICATIONS_ENGINE_WHATSAPP_SEND_ENABLED=false
# Fase 4 — retry (requer migração 131_notifications_engine_retry_and_ops.sql)
# NOTIFICATIONS_ENGINE_WHATSAPP_MAX_SEND_ATTEMPTS=4
# NOTIFICATIONS_ENGINE_RETRY_BASE_MS=15000
# NOTIFICATIONS_ENGINE_OUTBOUND_RETRY_POLL_MS=30000
# NOTIFICATIONS_ENGINE_VERBOSE_LOG=false
# Fase 4 — digest invoice.due_soon / invoice.overdue (opt-in; mesmo processo Node que a API)
# NOTIFICATIONS_ENGINE_INVOICE_DIGEST_ENABLED=false
# NOTIFICATIONS_ENGINE_INVOICE_DIGEST_POLL_MS=3600000
# NOTIFICATIONS_ENGINE_DUE_SOON_LOOKAHEAD_DAYS=3

# Motor de Notificações da PLATAFORMA (transacional; domínio separado do motor do tenant acima)
# Controlo operacional normal: Super Admin → GET/PUT /api/superadmin/platform-notifications/global-settings (superadmin_settings).
# Kill switches de emergência (se definidos explicitamente como false/0/no, forçam OFF em relação ao DB):
# PLATFORM_NOTIFICATIONS_ENABLED=true
# Fase 3: eventos reais (conta, cobrança, pagamento, plano). Se false, simulação Super Admin continua possível.
# PLATFORM_NOTIFICATIONS_BUSINESS_EVENTS_ENABLED=true
# PLATFORM_NOTIFICATIONS_WHATSAPP_SEND_ENABLED=true
# E-mail transacional (SMTP Super Admin). Se false, entregas email ficam skipped.
# PLATFORM_NOTIFICATIONS_EMAIL_SEND_ENABLED=true
# PLATFORM_NOTIFICATIONS_VERBOSE_LOG=false
# Aviso platform.trial.expiring (3 dias antes do fim do trial):
# PLATFORM_TRIAL_EXPIRING_NOTIFICATION_JOB=true
# PLATFORM_TRIAL_EXPIRING_NOTIFICATION_POLL_MS=21600000
# Remetente UazAPI (utilizador com instância no tenant indicado) — fallback se superadmin_settings vazios:
# PLATFORM_NOTIFICATIONS_DISPATCH_TENANT_ID=
# PLATFORM_NOTIFICATIONS_DISPATCH_SENDER_USER_ID=
# Retry/outbox (reutiliza NOTIFICATIONS_ENGINE_* para max attempts/base ms se estas omitidas):
# PLATFORM_NOTIFICATIONS_WHATSAPP_MAX_SEND_ATTEMPTS=
# PLATFORM_NOTIFICATIONS_RETRY_BASE_MS=
# PLATFORM_NOTIFICATIONS_OUTBOUND_RETRY_POLL_MS=30000

