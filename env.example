# Configuração do Banco de Dados PostgreSQL
# Use outra porta (ex.: 5433, 5434) se já tiver outro PostgreSQL na 5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=painelcrm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Configuração da API
API_PORT=3001
NODE_ENV=development
# Limite do body JSON (ex.: envio de imagem em base64 no chat). Padrão no código: 25mb.
# API_JSON_BODY_LIMIT=25mb

# Configuração JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Opcional: cifra do token de link público de visualização de contrato (recomendado em produção; 32+ caracteres).
# Se omitido, a chave é derivada de JWT_SECRET (menos ideal se o segredo JWT mudar).
# CONTRACT_PUBLIC_VIEW_TOKEN_ENCRYPTION_KEY=

# Configuração do Frontend (para CORS)
FRONTEND_URL=http://localhost:5173

# Nome público da plataforma (merge fields {{system.name}} no PDF/contrato). Opcional.
# APP_PUBLIC_NAME=PainelCRM

# Fase 1 — checkout único (opcional; bloqueio de cadastro legado)
DISABLE_PUBLIC_AUTH_REGISTER=false
DISABLE_PUBLIC_REGISTER_ORGANIZATION=false

# Frontend — Fase 1 (build-time)
# Opcional: nome exibido em previews de merge ({{system.name}}). Senão usa "PainelCRM".
# VITE_APP_PUBLIC_NAME=PainelCRM
# Redireciona /register para /checkout quando true
VITE_REDIRECT_REGISTER_TO_CHECKOUT=true
# Só redireciona para /onboarding quando true (legado)
VITE_FORCE_LEGACY_ONBOARDING_ROUTE=false

# Fase 2 — trial no checkout (backend: ligar explicitamente em cada ambiente)
# Se os três estiverem false, o gate de CRM trial/retomada e o ramo Fase 2 em cancelExpired ficam desligados.
CHECKOUT_TRIAL_V1=true
TRIAL_EXPIRATION_JOB=true
CHECKOUT_RESUME_V1=true

# Frontend — Fase 2
# CTA de trial: padrão ligado; defina VITE_CHECKOUT_TRIAL_V1=false para ocultar o botão de trial.
VITE_CHECKOUT_TRIAL_V1=true
VITE_CHECKOUT_RESUME_V1=true

# Opcional: segredo dedicado à assinatura de URLs públicas de mídia (GET /api/public/catalog-media/raw).
# Se omitido, usa JWT_SECRET. Se mudar o segredo, regenere links (re-gravar logos ou reemitir URLs).
# CATALOG_MEDIA_PUBLIC_TOKEN_SECRET=

# Catálogo / Loja — Fase 2 (upload local no servidor, multipart)
# Caminho físico da raiz de uploads. Dentro dele o backend usa a subpasta "catalog-media".
# EasyPanel: monte um volume PERSISTENTE neste caminho (ex.: /app/data/uploads).
# Se omitido, usa {diretório de trabalho do Node}/uploads/catalog-media (NÃO persiste entre redeploy sem volume).
# CATALOG_MEDIA_STORAGE_PATH=/app/data/uploads
#
# URL pública usada nas URLs gravadas no banco (logo, banner, images). Sem barra final.
# Use a mesma origem que o navegador usa para a API se o proxy repassar /media/catalog (recomendado).
# Ex.: https://app.seudominio.com ou  http://localhost:3001 (dev com front em outra porta)
# Se omitido, o backend monta a URL a partir do Host da requisição de upload (requer proxy/trust proxy corretos).
# CATALOG_MEDIA_PUBLIC_BASE_URL=https://app.seudominio.com
#
# URLs públicas de catálogo/logos: GET /api/public/catalog-media/raw?k=&s= (path sem .png; mesmo proxy que /api/public/...).
# Nginx: use location ^~ /api/ com proxy_pass ao Node (ver nginx.conf). Evita location regex *.png a servir /api/... como ficheiro estático.
#
# Limite por arquivo (bytes). Padrão no código: 5 MB.
# CATALOG_MEDIA_UPLOAD_MAX_BYTES=5242880
# Desliga upload no backend (503): CATALOG_MEDIA_UPLOAD_ENABLED=false
# CATALOG_MEDIA_UPLOAD_ENABLED=true
# Frontend: defina false para ocultar botões de upload (opcional).
# VITE_CATALOG_MEDIA_UPLOAD_ENABLED=true

# Loja — checkout público (1 item): liberado só pela loja em Admin → Loja (store_checkout_enabled + loja ativa).
# Não usa rotas /checkout (plano SaaS) nem /api/me/tenant/checkout-context.
# Limite dedicado do POST /api/store-checkout (requisições / 15 min por IP). Não contabiliza no RATE_LIMIT_MAX geral.
# RATE_LIMIT_STORE_CHECKOUT_MAX=40

# Etapa 3 — link público de visualização de contrato (GET /api/public/contracts/view/:token), requisições / 15 min por IP+token.
# RATE_LIMIT_PUBLIC_CONTRACT_VIEW_MAX=120

# Propostas — link público (GET /api/public/proposals/view/:token e POST accept|reject), / 15 min por IP+token.
# RATE_LIMIT_PUBLIC_PROPOSAL_VIEW_MAX=120
# RATE_LIMIT_PUBLIC_PROPOSAL_ACTION_MAX=40
# Tamanho do secret aleatório em bytes (default 32). Opcional.
# CONTRACT_PUBLIC_VIEW_TOKEN_BYTES=32
# Expiração opcional do token em dias (omitir = sem expiração automática).
# CONTRACT_PUBLIC_VIEW_TOKEN_EXPIRY_DAYS=

# Etapa 4 — convite público de assinatura por signatário
# RATE_LIMIT_PUBLIC_CONTRACT_SIGNATURE_GET_MAX=120
# RATE_LIMIT_PUBLIC_CONTRACT_SIGNATURE_POST_MAX=30
# CONTRACT_SIGNATURE_INVITE_EXPIRY_DAYS=

# Integração WhatsApp (UazAPI)
# UAZAPI_ADMIN_TOKEN: token administrativo do painel UazAPI (obrigatório no backend para POST /instance/init).
# Não é o JWT do usuário do PainelCRM — configure só no servidor / secrets.
UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_ADMIN_TOKEN=ZaW1qwTEkuq7Ub1cBUuyMiK5bNSu3nnMQ9lh7klElc2clSRV8t
UAZAPI_WEBHOOK_URL=http://localhost:3001/webhooks/uazapi
# Produção: use URL pública HTTPS (ou defina só PUBLIC_API_URL abaixo — o backend monta .../webhooks/uazapi).
# PUBLIC_API_URL=https://beta.painelcrm.com
UAZAPI_WEBHOOK_SECRET=my-webhook-secret
# O webhook também aceita o token da instância em ?secret= (comportamento comum da Uaz): deve coincidir com chat_instances.instance_token.
# Deve ser idêntico ao parâmetro ?secret= da URL na Uaz. Em produção confira as variáveis do deploy (Docker/PM2/host):
# aspas no valor, espaço final ou secret antigo causam invalid_secret mesmo com hasQuerySecret=true.
# O mesmo valor deve estar configurado no painel UazAPI (secret do webhook). O backend envia o secret no body
# da API Uaz e também em ?secret= na URL registrada, para o POST do webhook validar mesmo sem header.
# Após configurar o webhook, o backend chama GET /webhook na Uaz e grava metadata.webhook.uazDeliverySecrets
# para validar o ?secret= real que a Uaz usa na entrega (pode diferir do instance_token).
# Opcional: IPs fixos do provedor (vistos nos logs do webhook). Ex.: 116.202.152.37 — só use se confiar no proxy (trust proxy).
# UAZAPI_WEBHOOK_TRUST_IPS=116.202.152.37
# Produção: webhook exige secret definido. Só use durante migração:
# UAZAPI_WEBHOOK_ALLOW_NO_SECRET=true
# Logs detalhados da integração (payloads, handshake WS, etc.):
# UAZAPI_VERBOSE_LOGS=1
# Logs por mensagem em saveMessage (sync/webhook). Só ative para depuração pontual:
# CHAT_VERBOSE_SAVE=1

# Asaas — timeout HTTP por requisição (ms). Padrão no código: 40000; valores 5000–120000 são aplicados com piso 20000. Sandbox lento: aumente se necessário.
# ASAAS_HTTP_TIMEOUT_MS=45000

# Depuração pontual — listagem de conversas do chat (logs backend + ?diag=1 via frontend em DEV)
# CHAT_LIST_LOG=1
# VITE_CHAT_LIST_DIAG=1

