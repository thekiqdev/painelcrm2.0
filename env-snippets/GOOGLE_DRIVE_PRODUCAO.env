# =============================================================================
# Google Drive em produção — bloco para colar no .env do servidor
# =============================================================================
# Pré-requisito: já existir o bloco do Google Calendar com:
#   GOOGLE_CLIENT_ID
#   GOOGLE_CLIENT_SECRET
#   GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY  (mín. 16 caracteres; mesma chave do Calendar)
#   GOOGLE_REDIRECT_URI  (callback do Calendar — não substitua pelo do Drive)
#
# O Drive reutiliza CLIENT_ID / SECRET / ENCRYPTION_KEY; só o redirect OAuth é outro URL.

ENABLE_GOOGLE_DRIVE=true

# URL absoluta do callback da API (deve bater byte a byte com o cadastrado no Google Cloud)
GOOGLE_DRIVE_REDIRECT_URI=https://beta.painelcrm.com/api/integrations/google-drive/callback

# Usado após o OAuth para redirecionar ao /settings?section=googleDrive (sem barra no fim)
FRONTEND_URL=https://beta.painelcrm.com

# -----------------------------------------------------------------------------
# Checklist Google Cloud Console (APIs e serviços > Credenciais > Cliente OAuth)
# -----------------------------------------------------------------------------
# [ ] Em "URIs de redirecionamento autorizados", incluir EXATAMENTE:
#     https://beta.painelcrm.com/api/integrations/google-drive/callback
#     (além do URI do Calendar .../api/integrations/google/callback)
# [ ] Google Drive API habilitada no projeto
# [ ] Se o app usa escopo sensível (ex.: .../auth/drive): modo de teste só permite
#     contas de teste; em produção pode exigir verificação da tela de consentimento
#
# -----------------------------------------------------------------------------
# Opcional — logar parâmetros da URL de autorização (só para diagnóstico; evitar em rotina)
# GOOGLE_OAUTH_LOG_PARAMS=true
# =============================================================================
