# Billing scheduler — mesmo artefacto de build que Dockerfile.backend (API não exposta).
# EasyPanel: nome do serviço painelcrm-billing-scheduler → Dockerfile.billing.scheduler
# Loop: scripts/start-billing-scheduler.sh → node dist/scripts/runRecurringScheduler.js a cada ~600s.
FROM node:20-alpine AS builder

WORKDIR /app

COPY packages/backend/package*.json ./
RUN npm ci

COPY packages/backend/ ./
RUN npm run build

FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache tini

COPY packages/backend/package*.json ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist ./dist
COPY database ./database
COPY packages/backend/scripts ./scripts

COPY scripts/start-billing-scheduler.sh /usr/local/bin/start-billing-scheduler.sh
COPY scripts/billing-healthcheck-scheduler.sh /usr/local/bin/billing-healthcheck-scheduler.sh
RUN chmod +x /usr/local/bin/start-billing-scheduler.sh /usr/local/bin/billing-healthcheck-scheduler.sh

ENV NODE_ENV=production
ENV BILLING_APP_DIR=/app

HEALTHCHECK --interval=60s --timeout=10s --start-period=120s --retries=3 \
  CMD /usr/local/bin/billing-healthcheck-scheduler.sh

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["/usr/local/bin/start-billing-scheduler.sh"]
