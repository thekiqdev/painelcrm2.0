server {
    listen 0.0.0.0:80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    
    # Resolver DNS para resolver o host do backend em runtime
    # 127.0.0.11 é o DNS resolver padrão do Docker
    resolver 127.0.0.11 valid=10s;
    resolver_timeout 5s;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json;

    # WebSocket/Socket.IO proxy - DEVE VIR ANTES DE / PARA NÃO SER CAPTURADO
    # Use o mesmo host do backend (ex.: painelcrm-backend:3001)
    location ~ ^/socket\.io(/.*)?$ {
        set $backend "painelcrm-backend:3001";
        # Definir Connection header baseado em Upgrade (necessário para WebSocket)
        set $connection_upgrade "upgrade";
        if ($http_upgrade = '') {
            set $connection_upgrade "close";
        }
        
        # Preservar o path completo incluindo query string
        proxy_pass http://$backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;  # 24 horas para WebSocket
        proxy_send_timeout 86400s;
        proxy_connect_timeout 75s;
        proxy_buffering off;
        proxy_request_buffering off;
        
        # Permitir CORS para Socket.IO - deixar backend controlar CORS para evitar conflitos
        # Não adicionar headers CORS aqui, deixar o Socket.IO fazer isso
        
        # Logs para debug
        access_log /var/log/nginx/socketio_access.log;
        error_log /var/log/nginx/socketio_error.log debug;
        
        # Tratar OPTIONS para CORS - passar para backend ao invés de retornar 204
        # O Socket.IO precisa processar OPTIONS para configurar CORS corretamente
    }

    # API proxy - Nome do serviço backend no Easypanel/Docker
    # Se der 502: confira o hostname interno do backend (ex.: painelcrm-backend ou painelcrm_painelcrm-backend)
    location /api {
        set $backend "painelcrm-backend:3001";
        # Definir Connection header baseado em Upgrade (para suporte a WebSocket via API se necessário)
        set $connection_upgrade "upgrade";
        if ($http_upgrade = '') {
            set $connection_upgrade "close";
        }
        
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
        proxy_buffering off;
        proxy_request_buffering off;
        
        # Logs para debug
        access_log /var/log/nginx/api_access.log;
        error_log /var/log/nginx/api_error.log;
        
        # Tratamento de erros do proxy
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503;
        proxy_intercept_errors off;
    }

    # Webhooks proxy - Use o mesmo host do backend
    location /webhooks {
        set $backend "painelcrm-backend:3001";
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
        proxy_buffering off;
        proxy_request_buffering off;
        
        # Logs para debug de webhooks
        access_log /var/log/nginx/webhooks_access.log;
        error_log /var/log/nginx/webhooks_error.log;
        
        # Tratamento de erros do proxy
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503;
        proxy_intercept_errors off;
    }

    location ~* \.mjs$ {
        root /usr/share/nginx/html;
        default_type application/javascript;
        add_header Content-Type "application/javascript" always;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.wasm$ {
        root /usr/share/nginx/html;
        default_type application/wasm;
        add_header Content-Type "application/wasm" always;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Frontend routes - servir arquivos estáticos (DEVE VIR POR ÚLTIMO)
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Health check
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}

