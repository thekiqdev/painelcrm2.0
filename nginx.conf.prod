server {
    listen 0.0.0.0:80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    
    # Resolver DNS para resolver o host do backend em runtime
    # 127.0.0.11 é o DNS resolver padrão do Docker
    resolver 127.0.0.11 valid=10s;
    resolver_timeout 5s;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json;

    # Frontend routes - servir arquivos estáticos
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }
    
    # Servir arquivos estáticos (JS, CSS, imagens, etc)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # API proxy - Use o nome do serviço backend no Easypanel
    # IMPORTANTE: O nome deve corresponder EXATAMENTE ao nome do serviço no Easypanel
    # Se o serviço se chama "sistemas_painelcrm", use "sistemas_painelcrm:3001"
    # Se o serviço se chama "painelcrm", use "painelcrm:3001"
    location /api {
        set $backend "sistemas_painelcrm:3001";
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
        proxy_buffering off;
        proxy_request_buffering off;
        
        # Logs para debug
        access_log /var/log/nginx/api_access.log;
        error_log /var/log/nginx/api_error.log;
        
        # Tratamento de erros do proxy
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503;
        proxy_intercept_errors off;
    }

    # Webhooks proxy - Roteia webhooks para o backend
    location /webhooks {
        set $backend "sistemas_painelcrm:3001";
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
        proxy_buffering off;
        proxy_request_buffering off;
        
        # Logs para debug de webhooks
        access_log /var/log/nginx/webhooks_access.log;
        error_log /var/log/nginx/webhooks_error.log;
        
        # Tratamento de erros do proxy
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503;
        proxy_intercept_errors off;
    }

    # Health check
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}

