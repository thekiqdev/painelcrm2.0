# Template: __BACKEND_UPSTREAM__ é substituído no startup pelo entrypoint (env BACKEND_HOST)
# No Easypanel: variável de ambiente BACKEND_HOST = nome do serviço do backend (ex.: painelcrm-backend ou painelcrm_painelcrm-backend)
server {
    listen 0.0.0.0:80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    
    resolver 127.0.0.11 valid=10s;
    resolver_timeout 5s;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json;

    location ~ ^/socket\.io(/.*)?$ {
        set $backend "__BACKEND_UPSTREAM__";
        set $connection_upgrade "upgrade";
        if ($http_upgrade = '') {
            set $connection_upgrade "close";
        }
        proxy_pass http://$backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 75s;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location /api {
        set $backend "__BACKEND_UPSTREAM__";
        set $connection_upgrade "upgrade";
        if ($http_upgrade = '') {
            set $connection_upgrade "close";
        }
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $connection_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503;
    }

    location /webhooks {
        set $backend "__BACKEND_UPSTREAM__";
        proxy_pass http://$backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_next_upstream error timeout invalid_header http_500 http_502 http_503;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
}
